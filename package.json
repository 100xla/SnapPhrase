{
  "name": "snapphrase",
  "version": "1.6.0",
  "description": "SnapPhrase v1.6.0 — Fast, local, AES-256 encrypted text expander and snippet manager for Windows",
  "author": "SnapPhrase Project",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:exe": "node build/build-release.js nsis portable",
    "build:installer": "node build/build-release.js nsis",
    "build:portable": "node build/build-release.js portable",
    "build:store": "node build/build-release.js appx",
    "release": "node build/build-release.js --publish nsis portable",
    "version:patch": "node build/bump-version.js patch",
    "version:minor": "node build/bump-version.js minor",
    "publish:github": "node build/publish-github.js",
    "repo": "node build/set-repo.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^2.9.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.snapphrase.app",
    "productName": "SnapPhrase",
    "copyright": "Copyright © 2026 SnapPhrase Project",
    "publish": [
      {
        "provider": "github",
        "owner": "100xla",
        "repo": "SnapPhrase",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "snapphrase.ico",
      "snapphrase.png",
      "satztresor.ico",
      "satztresor.png",
      "logo.png",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      "snapphrase.ico"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SnapPhrase",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "appx": {
      "artifactName": "${productName}-Store-${version}.${ext}",
      "applicationId": "SnapPhrase",
      "identityName": "SnapPhrase.App",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "SnapPhrase",
      "displayName": "SnapPhrase - Text Expander and Snippet Vault",
      "backgroundColor": "#12131a",
      "showNameOnTiles": true,
      "addAutoLaunchExtension": true
    }
  }
}
